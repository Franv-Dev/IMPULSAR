# --- Variables de entorno / secretos ---
.env
.env.*
!.env.example

# --- Entornos virtuales ---
venv/
.env/
.venv/
env/
ENV/

# --- Python compilado / cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- Cobertura de tests ---
.coverage
.coverage.*
htmlcov/

# --- Base de datos local ---
*.sqlite3
*.sqlite3-journal
*.db

# --- Flask ---
instance/
.flaskenv

# --- Archivos subidos por usuarios (no versionar contenido, sí la carpeta) ---
static/uploads/*
!static/uploads/.gitkeep

# --- Editores / IDEs ---
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

