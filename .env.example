# Copiá este archivo como .env y completá los valores.
# El .env NUNCA se sube al repositorio (está en .gitignore).

# Entorno: development | testing | production
FLASK_ENV=development
# El entrypoint estable: no cambia aunque se mueva create_app (ver wsgi.py).
FLASK_APP=wsgi.py

# Claves de seguridad.
# En desarrollo podés dejarlas vacías (hay valores por defecto).
# En producción son OBLIGATORIAS: la app no arranca sin ellas.
# Generá una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Base de datos MySQL
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=3306
DB_NAME=impulsar_db

# Alternativa: si definís DATABASE_URL, tiene prioridad sobre las variables
# de arriba. Es lo que suelen inyectar los servicios de deploy.
# DATABASE_URL=mysql+pymysql://usuario:clave@host:3306/impulsar_db

# API de mapas (https://cloud.maptiler.com/account/keys/)
MAPTILER_KEY=

# Correo saliente, para las notificaciones por mail (mensaje nuevo, solicitud
# respondida, turno cancelado). Se manda por el SMTP de Gmail.
#
# MAIL_PASSWORD NO es la contraseña de la cuenta: es una "contraseña de
# aplicación" de Google, de 16 letras, que se genera en
# https://myaccount.google.com/apppasswords (hace falta tener la verificación
# en dos pasos activada) y se puede revocar sola, sin tocar la cuenta.
#
# Si las dejás vacías la app arranca igual y no manda ningún aviso: lo único
# que pasa es que queda una línea en el log diciendo que el mail no está
# configurado. Es lo que corresponde en desarrollo y en los tests.
MAIL_USERNAME=
MAIL_PASSWORD=
# Opcionales, con estos valores por defecto:
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# De qué dirección salen los avisos. Por defecto la misma de MAIL_USERNAME;
# Gmail reescribe el From si no coincide con la cuenta que autentica.
# MAIL_DEFAULT_SENDER=

# El dominio real. Solo lo lee ProductionConfig: en desarrollo, ponerlo o no
# ponerlo da igual.
# Es con lo que se arman los links de los mails de notificación. Sin esto el
# link sale con el host que venga en el header Host de la request, que se puede
# falsear: el mail lo mandamos nosotros y el link lleva a otro lado.
# SERVER_NAME=impulsar.com.ar
